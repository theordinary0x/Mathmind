{
  "name": "mathmind",
  "version": "1.3.0",
  "description": "基于 Web 的数学公理推导与命题图谱工具，具备高精度实时公式渲染与图布局算法。",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "mathmind": "bin/mathmind.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "electron:build": "electron-builder --win"
  },
  "keywords": [
    "math",
    "latex",
    "katex",
    "knowledge-graph",
    "mindmap",
    "cytoscape",
    "topology"
  ],
  "author": "theordinary0x <theordinary0x@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "cytoscape": "^3.30.4",
    "cytoscape-cose-bilkent": "^4.1.0",
    "cytoscape-dagre": "^2.5.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.19.16",
    "@types/cytoscape-dagre": "^2.3.3",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.theordinary0x.mathmind",
    "productName": "MathMind",
    "electronVersion": "33.2.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
